    "@react-pdf/renderer": "^4.9.0",
    "framer-motion": "^14.2.0",
    "jose": "^6.2.12",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-icons": "^5.7.0",
