    "@react-pdf/renderer": "^4.5.1",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.4",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.82.0",
